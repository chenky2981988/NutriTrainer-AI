-- v1 -> v2: foods the user teaches the app (PRD §6 rank 1, §7).
-- IF NOT EXISTS so it is safe on any device that already has some tables.
CREATE TABLE IF NOT EXISTS foodEntity (
    id                    TEXT NOT NULL PRIMARY KEY,
    canonicalName         TEXT NOT NULL,
    nameKey               TEXT NOT NULL,
    aliasesCsv            TEXT NOT NULL DEFAULT '',
    basis                 TEXT NOT NULL,
    source                TEXT NOT NULL,
    confidenceBand        TEXT NOT NULL,
    brand                 TEXT,
    pack                  TEXT,
    servingGrams          REAL,
    energyKcal            REAL NOT NULL,
    energyKj              REAL NOT NULL,
    proteinG              REAL NOT NULL,
    carbohydrateG         REAL NOT NULL,
    fatG                  REAL NOT NULL,
    fibreG                REAL NOT NULL,
    createdAtEpochMillis  INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS foodEntity_nameKey ON foodEntity(nameKey);
