    <!-- Onboarding · step titles + helpers -->
    <string name="ob_welcome_title">NutriTrainer AI</string>
    <string name="ob_welcome_helper">Describe meals in your own words. Estimates are editable, your data stays on this device, and everything works offline.</string>
    <string name="ob_welcome_benefit_1">Say what you ate — "two rotis and a katori of dal" — and it becomes an editable record.</string>
    <string name="ob_welcome_benefit_2">Every estimate shows its source and confidence. Nothing is hidden.</string>
    <string name="ob_welcome_benefit_3">Works fully offline. No account, no AI subscription for core tracking.</string>

    <string name="ob_food_pattern_title">Which foods do you eat?</string>
    <string name="ob_food_pattern_helper">This is the one setting we can't skip — it keeps suggestions safe.</string>
    <string name="ob_food_pattern_nonveg_note">Includes every vegetarian food. It does not mean every meal is non-veg.</string>

